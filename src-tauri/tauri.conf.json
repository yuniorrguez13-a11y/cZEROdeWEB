{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cZEROde",
  "version": "../package.json",
  "identifier": "com.czeroode.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": { "script": "node scripts/stage-web.mjs", "wait": true },
    "beforeBuildCommand": "node scripts/stage-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cZEROde",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: czstream: http://czstream.localhost https://czstream.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "worker-src": "'self'",
        "manifest-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Private encrypted file vault",
    "longDescription": "cZEROde keeps your photos, videos, music and files in an encrypted local vault and locks files into passphrase-protected .czd files you can send to someone else.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["czd"],
        "name": "cZEROde locked file",
        "description": "cZEROde locked file",
        "mimeType": "application/x-czeroode",
        "role": "Viewer"
      },
      {
        "ext": ["czb"],
        "name": "cZEROde backup",
        "description": "cZEROde backup",
        "mimeType": "application/x-czeroode-backup",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"],
        "desktopTemplate": "linux/czeroode.desktop",
        "files": {
          "/usr/share/mime/packages/czeroode.xml": "linux/czeroode-mime.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
