{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native open/save dialogs, the <AppData>/vault2 store (and the old <AppData>/vault folder, read by convention only), files/folders the user picks or opens with the app, and the releases page.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",
    "dialog:allow-save",

    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-fstat",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-truncate",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:deny-default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/vault2" },
        { "path": "$APPDATA/vault2/**" },
        { "path": "$APPDATA/vault" },
        { "path": "$APPDATA/vault/**" }
      ]
    },

    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/yuniorrguez13-a11y/cZEROdeWEB/releases" }]
    }
  ]
}
